# Пример окружения. Значений здесь нет и не будет: скопируй в .env и заполни руками.
#   cp .env.example .env
# Пояснения к существенным переменным — .docs/02-technical.md, раздел 5.

# Строка подключения к Postgres. Локально база поднимается docker-compose.yml,
# и тогда значение собирается из POSTGRES_* ниже:
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=

# База для vitest. Пустое значение — то же подключение, но база с суффиксом _test:
# тесты чистят таблицы целиком, и промах по адресу стоил бы рабочих данных. Совпадение
# с DATABASE_URL считается ошибкой и роняет прогон.
TEST_DATABASE_URL=

# Ключ шифрования refresh- и access-токенов Google в базе. 32 случайных байта в base64:
#   openssl rand -base64 32
# Потеря ключа = повторное подключение всех аккаунтов. Копию держать в менеджере паролей.
APP_ENCRYPTION_KEY=

# Хеш единственного пароля входа. Пользователь один, регистрации нет. Считается командой
#   pnpm auth:hash
# Значения в этом файле не берутся в кавычки, а `$имя` Next раскрывает как подстановку
# другой переменной — поэтому долларов в значениях быть не должно.
APP_PASSWORD_HASH=

# Учётные данные OAuth-клиента из Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Адрес возврата OAuth. Должен совпадать с прописанным в Google Cloud до символа.
# Локально: http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Токен доступа к MCP по HTTP (/api/mcp). Пока приложение локальное — не задан,
# и эндпоинт при пустом значении не поднимается вовсе, а не работает без проверки.
MCP_BEARER_TOKEN=

# Каталог вложений карточек. Абсолютных путей в репозитории нет: каталог задаётся
# здесь и монтируется томом. Внутрь src не класть.
ATTACHMENTS_DIR=

# Опасный переключатель: SYNC_DISABLED=1 останавливает фоновую синхронизацию.
# Удобно при отладке, но при долгом простое sync_token протухает и следующая
# синхронизация будет полной. Пустое значение — синхронизация включена.
SYNC_DISABLED=

# Дальше читает docker-compose.yml, не приложение. Пустые значения подхватывают
# дефолты, прописанные в самом compose-файле.

# Порт, на котором приложение видно на хосте. Должен совпадать с портом в
# GOOGLE_REDIRECT_URI и с адресом, записанным в консоли Google.
APP_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
