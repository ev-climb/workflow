#!/usr/bin/env bash
# Запуск приложения одной командой из любого каталога. Ставится симлинком:
#   ln -s "$PWD/bin/workflow" ~/.local/bin/workflow
set -euo pipefail

# корень проекта берётся от самого скрипта, а не из окружения: симлинк разворачивается
root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
cd "$root"

IMAGE=workflow-app
WATCH=(src public scripts package.json pnpm-lock.yaml next.config.ts postcss.config.mjs tsconfig.json Dockerfile docker-compose.yml)

if [[ ! -f .env ]]; then
  echo "нет .env: скопируй .env.example в .env и заполни" >&2
  exit 1
fi

port=$(sed -n 's/^APP_PORT=\([0-9]\+\).*/\1/p' .env | tail -1)
url="http://localhost:${port:-8477}/"

running() {
  docker compose ps --status running --services 2>/dev/null | grep -qx app
}

# образа нет или исходники свежее его — иначе в браузере откроется вчерашняя сборка
stale() {
  local created
  created=$(docker image inspect -f '{{.Created}}' "$IMAGE" 2>/dev/null) || return 0
  created=$(printf '%s' "$created" | sed -E 's/\.[0-9]+//')
  [[ -n $(find "${WATCH[@]}" -newermt "$created" -print -quit 2>/dev/null) ]]
}

wait_ready() {
  for _ in $(seq 60); do
    curl -sf -o /dev/null "$url" && return 0
    sleep 1
  done
  echo "приложение не ответило на $url за минуту, смотри: workflow logs" >&2
  return 1
}

case "${1:-start}" in
  start)
    if stale; then
      echo "исходники свежее образа, пересобираю"
      docker compose build --quiet
      docker compose up -d
    elif ! running; then
      docker compose up -d
    fi
    wait_ready
    xdg-open "$url" >/dev/null 2>&1 &
    echo "$url"
    ;;
  stop)
    # stop, а не down: контейнеры остаются, и следующий запуск не пересоздаёт их с нуля
    docker compose stop
    ;;
  restart)
    docker compose stop
    exec "$0" start
    ;;
  logs)
    exec docker compose logs -f app
    ;;
  password)
    # scrypt необратим: старый пароль не восстановить, только завести новый
    line=$(pnpm auth:hash)
    if grep -q '^APP_PASSWORD_HASH=' .env; then
      sed -i "s|^APP_PASSWORD_HASH=.*|$line|" .env
    else
      printf '%s\n' "$line" >> .env
    fi
    echo "пароль сменён, старые сессии больше не действуют"
    exec "$0" restart
    ;;
  backup)
    dir=$(sed -n 's/^BACKUP_DIR=//p' .env | tail -1)
    if [[ -z $dir ]]; then
      echo "задай BACKUP_DIR в .env: каталог вне проекта, git clean его не тронет" >&2
      exit 1
    fi
    stamp=$(date +%F-%H%M)
    # недописанный бэкап лежит под точкой и не выглядит готовым
    tmp="$dir/.$stamp"
    mkdir -p "$tmp"
    docker compose exec -T db sh -c 'pg_dump -Fc -U "$POSTGRES_USER" "$POSTGRES_DB"' >"$tmp/db.dump"
    # вложения пишет пользователь контейнера, поэтому и читаются из контейнера
    docker compose run --rm --no-deps -T --entrypoint tar app czf - -C /app attachments >"$tmp/attachments.tar.gz"
    mv "$tmp" "$dir/$stamp"
    find "$dir" -mindepth 1 -maxdepth 1 -type d -not -name '.*' | sort | head -n -14 | xargs -r rm -rf --
    echo "$dir/$stamp"
    ;;
  restore)
    src=${2:-}
    if [[ ! -f $src/db.dump || ! -f $src/attachments.tar.gz ]]; then
      echo "workflow restore <каталог бэкапа с db.dump и attachments.tar.gz>" >&2
      exit 1
    fi
    docker compose stop app
    docker compose up -d --wait db
    # база пересоздаётся, а не накатывается поверх: таблицы из миграций новее дампа
    # иначе остались бы, и migrate упал бы на них
    docker compose exec -T db sh -c 'dropdb --force -U "$POSTGRES_USER" "$POSTGRES_DB" &&
      createdb -U "$POSTGRES_USER" "$POSTGRES_DB" &&
      pg_restore --no-owner --exit-on-error -U "$POSTGRES_USER" -d "$POSTGRES_DB"' <"$src/db.dump"
    docker compose run --rm --no-deps -T --entrypoint sh app -c \
      'rm -rf /app/attachments/* && tar xzf - -C /app' <"$src/attachments.tar.gz"
    exec "$0" start
    ;;
  *)
    echo "workflow [start|stop|restart|logs|password|backup|restore <каталог>]" >&2
    exit 1
    ;;
esac
